<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="NFL Trade Sim" />
  <meta name="theme-color" content="#0b0f19" />
  <title>NFL Trade Simulator (Nov 2026)</title>
  <style>
    :root {
      --bg: #0b0f19;
      --card: #131a2b;
      --card-2: #1a2338;
      --border: #26324d;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --green: #22c55e;
      --yellow: #eab308;
      --red: #ef4444;
    }
    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      padding: env(safe-area-inset-top) 12px env(safe-area-inset-bottom) 12px;
    }
    header {
      text-align: center;
      padding: 14px 8px 10px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 12px;
    }
    h1 { font-size: 1.25rem; margin: 0 0 4px; letter-spacing: -0.02em; }
    .sub { font-size: 0.78rem; color: var(--muted); }
    .meter-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
      margin-bottom: 12px;
      position: sticky;
      top: 6px;
      z-index: 20;
      box-shadow: 0 10px 25px rgba(0,0,0,0.45);
    }
    .meter-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 6px;
    }
    .bar-wrap {
      width: 100%;
      height: 10px;
      background: #1e293b;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 8px;
    }
    .bar-fill {
      height: 100%;
      width: 50%;
      background: var(--yellow);
      transition: width 0.25s ease, background 0.25s ease;
    }
    .meter-actions { display: flex; gap: 8px; justify-content: space-between; align-items: center; }
    .btn { border: none; border-radius: 10px; padding: 8px 12px; font-weight: 700; font-size: 0.82rem; cursor: pointer; }
    .btn-primary { background: var(--accent); color: #08101e; flex: 1; }
    .btn-ghost { background: var(--card-2); color: var(--text); border: 1px solid var(--border); }
    .grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
    @media (min-width: 820px) { .grid { grid-template-columns: 1fr 1fr; } }
    .team-box { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 12px; }
    select, input {
      width: 100%; background: var(--card-2); color: var(--text);
      border: 1px solid var(--border); border-radius: 10px;
      padding: 9px 10px; font-size: 0.9rem; margin-bottom: 8px;
    }
    .needs-row { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 8px; font-size: 0.72rem; }
    .tag { background: #1e293b; color: var(--accent); padding: 2px 7px; border-radius: 6px; font-weight: 600; }
    .package { background: #0e1422; border: 1px dashed var(--border); border-radius: 10px; padding: 8px; min-height: 54px; margin-bottom: 8px; }
    .pkg-item {
      display: flex; justify-content: space-between; align-items: center;
      background: var(--card-2); padding: 6px 8px; border-radius: 8px; font-size: 0.8rem; margin-bottom: 4px;
    }
    .tabs { display: flex; gap: 4px; margin-bottom: 8px; overflow-x: auto; }
    .tab {
      background: var(--card-2); color: var(--muted); border: 1px solid var(--border);
      border-radius: 8px; padding: 5px 9px; font-size: 0.75rem; font-weight: 600; white-space: nowrap;
    }
    .tab.active { background: var(--accent); color: #08101e; border-color: var(--accent); }
    .list { max-height: 360px; overflow-y: auto; display: flex; flex-direction: column; gap: 5px; }
    .row {
      display: flex; justify-content: space-between; align-items: center;
      background: var(--card-2); padding: 8px 10px; border-radius: 9px; font-size: 0.82rem;
    }
    .badge-ir { background: rgba(239,68,68,0.2); color: #fca5a5; padding: 1px 5px; border-radius: 4px; font-size: 0.68rem; margin-left: 4px; }
    .badge-q { background: rgba(234,179,8,0.2); color: #fde047; padding: 1px 5px; border-radius: 4px; font-size: 0.68rem; margin-left: 4px; }
    .val { font-weight: 700; color: var(--accent); font-size: 0.78rem; }
  </style>
</head>
<body>
  <header>
    <h1>🏈 NFL Trade Simulator</h1>
    <div class="sub">Nov 2026 ESPN 53-Man Rosters • Rich Hill Pick Curve • Positional & Need Scaling</div>
  </header>

  <div class="meter-card">
    <div class="meter-top">
      <span id="statusText">Select players or draft picks to build a trade</span>
      <span id="scoreText">0 vs 0 pts</span>
    </div>
    <div class="bar-wrap"><div class="bar-fill" id="barFill"></div></div>
    <div class="meter-actions">
      <button class="btn btn-primary" onclick="proposeTrade()">Propose Trade</button>
      <button class="btn btn-ghost" onclick="resetTrade()">Reset</button>
    </div>
  </div>

  <div class="grid">
    <div class="team-box" id="boxA"></div>
    <div class="team-box" id="boxB"></div>
  </div>

  <script>window.NFL_ROSTERS = {};</script>
  <script src="rosters_part1.js"></script>
  <script src="rosters_part2.js"></script>
  <script src="rosters_part3.js"></script>
  <script src="rosters_part4.js"></script>  <script>
    const TEAMS = {
      ARI:{name:"Arizona Cardinals",needs:["QB","OL","EDGE","CB"]},
      ATL:{name:"Atlanta Falcons",needs:["WR","DL","LB","S"]},
      BAL:{name:"Baltimore Ravens",needs:["OL","WR","EDGE","CB"]},
      BUF:{name:"Buffalo Bills",needs:["DL","LB","CB","OL"]},
      CAR:{name:"Carolina Panthers",needs:["EDGE","TE","OL","CB"]},
      CHI:{name:"Chicago Bears",needs:["EDGE","OL","S","LB"]},
      CIN:{name:"Cincinnati Bengals",needs:["OL","CB","S","TE"]},
      CLE:{name:"Cleveland Browns",needs:["QB","OT","WR","LB"]},
      DAL:{name:"Dallas Cowboys",needs:["RB","LB","CB","OT"]},
      DEN:{name:"Denver Broncos",needs:["RB","LB","DL","TE"]},
      DET:{name:"Detroit Lions",needs:["EDGE","CB","OG","LB"]},
      GB:{name:"Green Bay Packers",needs:["CB","OL","DL","LB"]},
      HOU:{name:"Houston Texans",needs:["OL","DT","TE","CB"]},
      IND:{name:"Indianapolis Colts",needs:["QB","EDGE","WR","OL"]},
      JAX:{name:"Jacksonville Jaguars",needs:["OL","RB","LB","TE"]},
      KC:{name:"Kansas City Chiefs",needs:["OT","CB","DL","EDGE"]},
      LV:{name:"Las Vegas Raiders",needs:["WR","CB","OL","DL"]},
      LAR:{name:"Los Angeles Rams",needs:["QB","LB","OL","CB"]},
      MIA:{name:"Miami Dolphins",needs:["QB","OL","CB","DT"]},
      MIN:{name:"Minnesota Vikings",needs:["QB","CB","DT","LB"]},
      NE:{name:"New England Patriots",needs:["OT","EDGE","TE","S"]},
      NO:{name:"New Orleans Saints",needs:["QB","WR","EDGE","OG"]},
      NYG:{name:"New York Giants",needs:["OL","WR","CB","LB"]},
      NYJ:{name:"New York Jets",needs:["QB","WR","CB","OL"]},
      PHI:{name:"Philadelphia Eagles",needs:["TE","CB","EDGE","OG"]},
      PIT:{name:"Pittsburgh Steelers",needs:["QB","WR","OT","CB"]},
      SF:{name:"San Francisco 49ers",needs:["OL","CB","S","WR"]},
      SEA:{name:"Seattle Seahawks",needs:["EDGE","TE","LB","CB"]},
      TB:{name:"Tampa Bay Buccaneers",needs:["EDGE","LB","CB","TE"]},
      TEN:{name:"Tennessee Titans",needs:["EDGE","WR","OT","CB"]},
      WAS:{name:"Washington Commanders",needs:["EDGE","CB","WR","OL"]}
    };

    const POS_MULT = {
      QB: 1.65, EDGE: 1.32, OT: 1.28, LT: 1.30, RT: 1.25, WR: 1.24, CB: 1.22,
      DT: 1.12, DE: 1.18, S: 1.04, LB: 1.00, OG: 1.02, LG: 1.02, RG: 1.02,
      C: 1.04, TE: 0.96, RB: 0.88, FB: 0.65, K: 0.45, P: 0.40, LS: 0.30
    };

    const R1_ORDER = ["TEN","LAC","MIA","NYJ","PHI","NYJ","ARI","ATL","TB","NO","WAS","NYJ","HOU","BAL","LV","NE","SEA","CLE","CAR","CLE","DAL","NYG","PIT","DEN","CIN","PHI","MIN","TEN","KC","DET","SF","BUF"];
    const R1_ORIG  = ["TEN","LAC","MIA","NYJ","PHI","IND","ARI","ATL","TB","NO","WAS","DAL","HOU","BAL","LV","NE","SEA","LAR","CAR","CLE","GB","NYG","PIT","DEN","CIN","JAX","MIN","CHI","KC","DET","SF","BUF"];

    function richHillPick(pickNum) {
      return Math.max(2, Math.round(1000 * Math.pow(0.968, pickNum - 1)));
    }

    function buildPicks() {
      const picks = {};
      Object.keys(TEAMS).forEach(t => picks[t] = []);
      R1_ORDER.forEach((owner, idx) => {
        const num = idx + 1;
        const via = R1_ORIG[idx] !== owner ? ` (via ${R1_ORIG[idx]})` : "";
        picks[owner].push({ id: `2027-1-${num}`, label: `2027 Rd 1 • Pick #${num}${via}`, val: richHillPick(num) });
      });
      Object.keys(TEAMS).forEach((t, i) => {
        for (let r = 2; r <= 7; r++) {
          const overall = (r - 1) * 32 + ((i % 32) + 1);
          picks[t].push({ id: `2027-${r}-${t}`, label: `2027 Rd ${r} (Proj #${overall})`, val: richHillPick(overall) });
        }
       .forEach(r => {
          const base = r === 1 ? 260 : r === 2 ? 110 : 52;
          picks[t].push({ id: `2028-${r}-${t}`, label: `2028 Rd ${r} Pick`, val: base });
        });
      });
      return picks;
    }

    const ALL_PICKS = buildPicks();

    function calcPlayerVal(p, receivingTeam) {
      const ovr = p.ovr || 72;
      let base = ovr >= 95 ? 950 + (ovr - 95) * 180
               : ovr >= 90 ? 560 + (ovr - 90) * 78
               : ovr >= 85 ? 310 + (ovr - 85) * 50
               : ovr >= 80 ? 140 + (ovr - 80) * 34
               : ovr >= 75 ? 45 + (ovr - 75) * 19
               : Math.max(8, (ovr - 60) * 3);
      const mult = POS_MULT[p.pos] || 1.0;
      let val = base * mult;
      if (p.status === "IR") val *= 0.82;
      const needs = TEAMS[receivingTeam]?.needs || [];
      if (needs.includes(p.pos) || (needs.includes("OL") && ["LT","LG","C","RG","RT","OT","OG"].includes(p.pos))) {
        val *= 1.15;
      }
      return Math.round(val);
    }

    const state = {
      teamA: "LAC",
      teamB: "MIN",
      tabA: "ALL",
      tabB: "ALL",
      searchA: "",
      searchB: "",
      pkgA: [],
      pkgB: []
    };

