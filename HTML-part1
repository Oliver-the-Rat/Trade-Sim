<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="NFL Trade Sim" />
  <meta name="theme-color" content="#0b0f19" />
  <title>NFL Trade Simulator (Nov 2026)</title>
  <style>
    :root {
      --bg: #0b0f19;
      --card: #131a2b;
      --card-2: #1a2338;
      --border: #26324d;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --accent: #38bdf8;
      --green: #22c55e;
      --yellow: #eab308;
      --red: #ef4444;
    }
    * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, sans-serif;
      background: var(--bg);
      color: var(--text);
      padding: env(safe-area-inset-top) 12px env(safe-area-inset-bottom) 12px;
    }
    header {
      text-align: center;
      padding: 14px 8px 10px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 12px;
    }
    h1 { font-size: 1.25rem; margin: 0 0 4px; letter-spacing: -0.02em; }
    .sub { font-size: 0.78rem; color: var(--muted); }
    .meter-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px;
      margin-bottom: 12px;
      position: sticky;
      top: 6px;
      z-index: 20;
      box-shadow: 0 10px 25px rgba(0,0,0,0.45);
    }
    .meter-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 6px;
    }
    .bar-wrap {
      width: 100%;
      height: 10px;
      background: #1e293b;
      border-radius: 999px;
      overflow: hidden;
      margin-bottom: 8px;
    }
    .bar-fill {
      height: 100%;
      width: 50%;
      background: var(--yellow);
      transition: width 0.25s ease, background 0.25s ease;
    }
    .meter-actions { display: flex; gap: 8px; justify-content: space-between; align-items: center; }
    .btn { border: none; border-radius: 10px; padding: 8px 12px; font-weight: 700; font-size: 0.82rem; cursor: pointer; }
    .btn-primary { background: var(--accent); color: #08101e; flex: 1; }
    .btn-ghost { background: var(--card-2); color: var(--text); border: 1px solid var(--border); }
    .grid { display: grid; grid-template-columns: 1fr; gap: 12px; }
    @media (min-width: 820px) { .grid { grid-template-columns: 1fr 1fr; } }
    .team-box { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 12px; }
    select, input {
      width: 100%; background: var(--card-2); color: var(--text);
      border: 1px solid var(--border); border-radius: 10px;
      padding: 9px 10px; font-size: 0.9rem; margin-bottom: 8px;
    }
    .needs-row { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 8px; font-size: 0.72rem; }
    .tag { background: #1e293b; color: var(--accent); padding: 2px 7px; border-radius: 6px; font-weight: 600; }
    .package { background: #0e1422; border: 1px dashed var(--border); border-radius: 10px; padding: 8px; min-height: 54px; margin-bottom: 8px; }
    .pkg-item {
      display: flex; justify-content: space-between; align-items: center;
      background: var(--card-2); padding: 6px 8px; border-radius: 8px; font-size: 0.8rem; margin-bottom: 4px;
    }
    .tabs { display: flex; gap: 4px; margin-bottom: 8px; overflow-x: auto; }
    .tab {
      background: var(--card-2); color: var(--muted); border: 1px solid var(--border);
      border-radius: 8px; padding: 5px 9px; font-size: 0.75rem; font-weight: 600; white-space: nowrap;
    }
    .tab.active { background: var(--accent); color: #08101e; border-color: var(--accent); }
    .list { max-height: 360px; overflow-y: auto; display: flex; flex-direction: column; gap: 5px; }
    .row {
      display: flex; justify-content: space-between; align-items: center;
      background: var(--card-2); padding: 8px 10px; border-radius: 9px; font-size: 0.82rem;
    }
    .badge-ir { background: rgba(239,68,68,0.2); color: #fca5a5; padding: 1px 5px; border-radius: 4px; font-size: 0.68rem; margin-left: 4px; }
    .badge-q { background: rgba(234,179,8,0.2); color: #fde047; padding: 1px 5px; border-radius: 4px; font-size: 0.68rem; margin-left: 4px; }
    .val { font-weight: 700; color: var(--accent); font-size: 0.78rem; }
  </style>
</head>
<body>
  <header>
    <h1>🏈 NFL Trade Simulator</h1>
    <div class="sub">Nov 2026 ESPN 53-Man Rosters • Rich Hill Pick Curve • Positional & Need Scaling</div>
  </header>

  <div class="meter-card">
    <div class="meter-top">
      <span id="statusText">Select players or draft picks to build a trade</span>
      <span id="scoreText">0 vs 0 pts</span>
    </div>
    <div class="bar-wrap"><div class="bar-fill" id="barFill"></div></div>
    <div class="meter-actions">
      <button class="btn btn-primary" onclick="proposeTrade()">Propose Trade</button>
      <button class="btn btn-ghost" onclick="resetTrade()">Reset</button>
    </div>
  </div>

  <div class="grid">
    <div class="team-box" id="boxA"></div>
    <div class="team-box" id="boxB"></div>
  </div>

  <script>window.NFL_ROSTERS = {};</script>
  <script src="rosters_part1.js"></script>
  <script src="rosters_part2.js"></script>
  <script src="rosters_part3.js"></script>
  <script src="rosters_part4.js"></script>
